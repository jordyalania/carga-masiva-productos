# Copy using: python3 backend/tests/setup_env.py. Do not commit .env.
POSTGRES_PASSWORD=replace-with-random-value
RABBITMQ_PASSWORD=replace-with-random-value
JWT_KEY=replace-with-at-least-32-random-bytes
INTERNAL_KEY=replace-with-random-value
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=replace-with-a-long-password
# Local SMTP inbox. Configure a real provider before server deployment.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.test
# Bind local-only. Set up HTTPS reverse proxy before external exposure.
BIND_ADDRESS=127.0.0.1
API_PORT=8080
MAIL_UI_PORT=8025
RABBIT_UI_PORT=15672

WEB_PORT=5180
# Default for uploads without chosen recipients. Empty uses the authenticated user's email.
NOTIFICATION_TEST_RECIPIENT=
# Only required for compose.mailersend.yaml. Use SMTP credentials, not an API key.
MAILERSEND_SMTP_USER=
MAILERSEND_SMTP_PASSWORD=
MAILERSEND_FROM=
# Frontend-only visual mode with sample data; Docker builds always use the real backend.
VITE_DEMO_MODE=false
VITE_API_BASE_URL=
# Only for compose.server.yaml; configure DNS to the target server first.
APP_DOMAIN=
# Only for compose.traefik.yaml: existing Traefik network, ACME resolver and HTTPS entrypoint.
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=
TRAEFIK_ENTRYPOINT=websecure
